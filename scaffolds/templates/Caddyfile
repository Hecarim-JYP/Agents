# 리버스 프록시(Caddy) — 외부 노출 + 도메인일 때 선택한다 (체크리스트 15, docker.md 7절).
# HTTPS 종단 + 라우팅만 담당한다. 사내망 전용 기본은 nginx-proxy.conf.
# 정적 파일은 client(nginx) 컨테이너가 서빙한다 — 2026-07-14 확정.
# SITE_ADDRESS: 도메인이면 자동 HTTPS, 사내 도메인 미확보면 ":80" (체크리스트 15)
# X-Forwarded-For: Caddy는 기본으로 클라이언트가 보낸 값을 버리고 접속 IP로 새로 쓴다 — 별도 설정 불필요
#   (features/rate-limit.md 3-1절, 2026-10-16 Caddy 2.6.2 실측)
#
# 아래는 Node/Express(내부 포트 3000) 기준. Spring Boot면 두 곳을 바꾼다 (2026-07-14 검증):
#   - reverse_proxy server:8080
#   - /health 블록에 `rewrite * /actuator/health` 한 줄 추가 (actuator 표준 경로)

{$SITE_ADDRESS}

# 보안 헤더 — 화면·API·파일 응답 전부 (features/security-headers.md 3-1절)
header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	# HTTPS일 때만 효력 — HTTP 응답의 HSTS는 브라우저가 무시한다(RFC 6797 8.1절). includeSubDomains는 붙이지 않는다(security-headers.md 2절)
	Strict-Transport-Security "max-age=31536000"
	-Server
	# CSP — 대외 필수. 켠 뒤 배포 화면에서 콘솔 위반 0건 확인 (security-headers.md 3-2절)
	# Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# 텍스트 응답 압축 — Caddy는 기본으로 압축하지 않는다 (features/static-assets.md 3-2절)
encode zstd gzip

# 컨테이너 IP가 재배포로 바뀌어도 Caddy는 연결할 때마다 이름을 다시 해석한다 — 별도 설정 불필요 (zero-downtime-deploy.md 3-1절, 2026-10-19 실측)
handle /api/* {
	reverse_proxy server:3000
}

handle /health {
	reverse_proxy server:3000
}

handle {
	reverse_proxy client:8080
}

# 앱·client가 내려가 있는 동안(배포·재시작) — /api는 JSON 503, 화면은 안내 HTML 503 (features/maintenance-mode.md 3-1절)
# 502·504(프록시가 앱에 못 닿음)만 바꾼다 — 앱이 직접 보낸 에러 봉투는 그대로 통과. /health는 그대로 502(가동 감시가 진짜 장애를 봐야 함)
# Caddy 2.6은 `handle_errors 502 504` 형식을 지원하지 않는다 — expression 매처로 쓴다 (2026-10-16 실측)
handle_errors {
	@api_down {
		expression `{err.status_code} in [502, 504]`
		path /api/*
	}
	@page_down {
		expression `{err.status_code} in [502, 504]`
		not path /api/* /health
	}
	handle @api_down {
		header Content-Type "application/json"
		header Retry-After "30"
		respond `{"message":"서비스 점검 중입니다. 잠시 후 다시 시도해 주세요.","error":"SERVICE_UNAVAILABLE"}` 503
	}
	handle @page_down {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond `<!doctype html><meta charset="utf-8"><title>점검 중</title><p>서비스 점검 중입니다. 잠시 후 새로고침해 주세요.</p>` 503
	}
}
